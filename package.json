{
  "name": "dysros",
  "version": "0.0.2",
  "description": "Local-first desktop tracker for a reselling operation: reads your mailboxes and turns order, shipping, cancellation and refund mail into inventory, purchases and shipments.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:main": "node build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "vite",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "smoke": "npm run build && electron scripts/smoke.cjs"
  },
  "keywords": [],
  "author": "DonkeyXBT",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "imapflow": "^1.7.1",
    "mailparser": "^3.9.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "main": "dist/main/index.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/DonkeyXBT/DysrOS.git"
  },
  "build": {
    "appId": "com.donkeyxbt.resellops",
    "productName": "Resell Ops",
    "copyright": "Copyright © 2026 DonkeyXBT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DonkeyXBT",
        "repo": "DysrOS",
        "releaseType": "release"
      }
    ]
  },
  "overrides": {
    "@electron/asar": "^4.3.0",
    "global-agent": "^4.1.3",
    "rimraf": "^6.1.3"
  }
}
